    {
      "parameters": {
        "jsCode": "// One metrics response, bracketed by status requests from the same server session.\nconst config = $('Tracker Configuration').first().json;\nconst before = $('HTTP - Status Before Metrics').first().json;\nconst after = $('HTTP - Strata Status').first().json;\nconst metrics = $('HTTP - Strata Metrics').first().json.data;\nfunction started(value) {\n  if (!Number.isSafeInteger(value) || value <= 0) {\n    throw new Error('Strata status.started must be a positive safe integer Unix timestamp');\n  }\n  return value;\n}\nconst server_started_at = started(after.started);\nif (started(before.started) !== server_started_at) {\n  throw new Error('Strata restarted while sampling; discard this cycle');\n}\nif (typeof metrics !== 'string') throw new Error('Strata /metrics must return text');\nconst names = [config.input_metric, config.output_metric];\nif (names.some(name => typeof name !== 'string' || !/^[a-zA-Z_:][a-zA-Z0-9_:]*$/.test(name)) || names[0] === names[1]) {\n  throw new Error('Configure two distinct valid Prometheus metric names');\n}\nconst values = {};\nconst max = 18446744073709551615n;\nfor (const raw of metrics.split(/\\r?\\n/)) {\n  const line = raw.trim();\n  if (!line || line.startsWith('#')) continue;\n  const name = line.match(/^([^\\s{]+)/)?.[1];\n  if (!names.includes(name)) continue;\n  // Accept an optional Prometheus label set and optional integer sample timestamp.\n  // More than one series for a required counter is ambiguous: fail instead of summing.\n  const match = line.match(/^([^\\s{]+)(?:\\{(?:[a-zA-Z_][a-zA-Z0-9_]*=\"(?:[^\"\\\\\\n]|\\\\[\\\\\"n])*\"(?:\\s*,\\s*[a-zA-Z_][a-zA-Z0-9_]*=\"(?:[^\"\\\\\\n]|\\\\[\\\\\"n])*\")*\\s*,?)?\\})?\\s+([0-9]+)(?:\\s+[0-9]+)?$/);\n  if (!match) throw new Error(`Malformed integer counter: ${name}`);\n  if (Object.hasOwn(values, name)) throw new Error(`Ambiguous duplicate counter: ${name}`);\n  const value = BigInt(match[2]);\n  if (value > max) throw new Error(`Counter exceeds MySQL BIGINT UNSIGNED: ${name}`);\n  values[name] = value <= BigInt(Number.MAX_SAFE_INTEGER) ? Number(value) : value.toString();\n}\nfor (const name of names) {\n  if (!Object.hasOwn(values, name)) throw new Error(`Missing required Strata counter: ${name}`);\n}\nreturn [{ json: {\n  instance_id: config.instance_id,\n  recorded_at: $now.setZone('Asia/Hong_Kong').toFormat('yyyy-MM-dd HH:mm:ss.SSS'),\n  server_started_at,\n  input_total: values[names[0]],\n  output_total: values[names[1]],\n} }];"
      },
      "id": "e4d28029-4334-44a8-bb30-0605cde95e67",
      "name": "Code - Parse Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, server_started_at, input_total, output_total\nFROM strata_token_usage\nWHERE instance_id = $1\nORDER BY id DESC\nLIMIT 1;",
        "options": {
          "queryBatching": "single",
          "queryReplacement": "={{ [$json.instance_id] }}",
          "largeNumbersOutput": "text"
        }
      },
      "id": "a5bf1d3a-33ba-4398-b16e-84338b233d85",
      "name": "MySQL - Get Latest Snapshot",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        1792,
        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "mySql": {
          "id": "BmfH4Z5fAM6wGc9P",
          "name": "MySQL Credentials (api usage)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const current = $('Code - Parse Metrics').first().json;\nconst items = $input.all();\nif (items.length !== 1) throw new Error('Expected exactly one previous snapshot or one empty item');\nconst previous = items[0].json;\nconst max = 18446744073709551615n;\nfunction integer(value, field) {\n  if (typeof value === 'number' && (!Number.isSafeInteger(value) || value < 0)) {\n    throw new Error(`Unsafe or negative integer: ${field}`);\n  }\n  if (!/^[0-9]+$/.test(String(value))) throw new Error(`Invalid integer: ${field}`);\n  const n = BigInt(value);\n  if (n > max) throw new Error(`Integer overflow: ${field}`);\n  return n;\n}\nfunction jsonInteger(n) {\n  return n <= BigInt(Number.MAX_SAFE_INTEGER) ? Number(n) : n.toString();\n}\nconst input = integer(current.input_total, 'input_total');\nconst output = integer(current.output_total, 'output_total');\nlet inputDelta = 0n, outputDelta = 0n;\nconst empty = Object.keys(previous).length === 0;\nif (!empty) {\n  if (integer(previous.id, 'previous.id') === 0n) throw new Error('Invalid previous snapshot id');\n  const oldStarted = integer(previous.server_started_at, 'previous.server_started_at');\n  const oldInput = integer(previous.input_total, 'previous.input_total');\n  const oldOutput = integer(previous.output_total, 'previous.output_total');\n  if (oldStarted !== integer(current.server_started_at, 'server_started_at')) {\n    inputDelta = input;\n    outputDelta = output;\n  } else {\n    if (input < oldInput || output < oldOutput) {\n      throw new Error('Counter inconsistency: counter decreased without a Strata restart; snapshot rejected');\n    }\n    inputDelta = input - oldInput;\n    outputDelta = output - oldOutput;\n  }\n}\nif (inputDelta + outputDelta > max) throw new Error('total_delta exceeds MySQL BIGINT UNSIGNED');\nreturn [{ json: { ...current,\n  previous_id: empty ? 0 : previous.id,\n  input_delta: jsonInteger(inputDelta),\n  output_delta: jsonInteger(outputDelta),\n} }];"
      },
      "id": "3aa7e4fb-8697-4f75-83a3-0eba96081253",
      "name": "Code - Calculate Usage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CALL strata_tracker_insert($1, $2, $3,\n  CAST(SUBSTRING($4, 2) AS UNSIGNED), CAST(SUBSTRING($5, 2) AS UNSIGNED), CAST(SUBSTRING($6, 2) AS UNSIGNED), CAST(SUBSTRING($7, 2) AS UNSIGNED), CAST(SUBSTRING($8, 2) AS UNSIGNED), CAST(SUBSTRING($9, 2) AS UNSIGNED));",
        "options": {
          "queryBatching": "single",
          "queryReplacement": "={{ [$json.instance_id, $('MySQL - Acquire Lease').first().json.lease_owner, $json.recorded_at, ...['server_started_at','input_total','output_total','input_delta','output_delta','previous_id'].map(k => 'n' + $json[k])] }}",
          "largeNumbersOutput": "text"
        }
      },
