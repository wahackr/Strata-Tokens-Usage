      "id": "be209bfe-d4c0-42ce-b526-a926a99c9a35",
      "name": "HTTP - Strata Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1344,
        0
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "RAbWUP0vDl00ryE4",
          "name": "Strata Endpoints Auth"
        }
      }
